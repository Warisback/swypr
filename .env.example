VITE_USE_MOCK=true
# Leave blank to use the Vite /api proxy on localhost:3001.
VITE_API_BASE=

# --- server (see PARTNER_TASKS.md section E) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
IG_ACCESS_TOKEN=
IG_USER_ID=
VERIFY_TOKEN=
# comma-separated tester IGSIDs, copied from data/webhook_log.json
WHITELIST_IGSIDS=
# SIMULATE or LIVE
MODE=SIMULATE
# exact Graph API version from the Meta app dashboard quickstart, e.g. v23.0
IG_GRAPH_VERSION=
